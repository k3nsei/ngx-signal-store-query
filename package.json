{
  "name": "@ngx-signal-store-query/source",
  "version": "0.11.0",
  "private": true,
  "scripts": {
    "build:demo": "ng build demo --configuration=production",
    "build:lib": "ng build ngx-signal-store-query --configuration=production",
    "clear-snapshots": "rimraf -g \"{apps,libs}/**/__snapshots__\"",
    "e2e:install-browsers": "pnpm run --dir=apps/demo-e2e install-browsers",
    "e2e:test": "pnpm run --dir=apps/demo-e2e test",
    "e2e:test-with-ui": "pnpm run --dir=apps/demo-e2e test --ui",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "ng lint",
    "ng": "ng",
    "prepare": "(git config core.hookspath .githooks && chmod +x .githooks/*) || true",
    "serve": "ng serve demo",
    "test": "ng test",
    "test:all": "pnpm test:demo --no-watch --quiet --no-watch && pnpm test:lib --no-watch --quiet",
    "test:demo": "ng test demo",
    "test:lib": "ng test ngx-signal-store-query"
  },
  "dependencies": {
    "@angular/cdk": "22.1.3",
    "@angular/common": "22.1.3",
    "@angular/compiler": "22.1.3",
    "@angular/core": "22.1.3",
    "@angular/forms": "22.1.3",
    "@angular/material": "22.1.3",
    "@angular/platform-browser": "22.1.3",
    "@angular/platform-server": "22.1.3",
    "@angular/router": "22.1.3",
    "@angular/ssr": "22.1.5",
    "@ngrx/signals": "21.1.1",
    "@tanstack/angular-query-experimental": "5.101.4",
    "@tanstack/query-devtools": "5.101.4",
    "express": "5.2.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "22.1.5",
    "@angular/cli": "22.1.5",
    "@angular/compiler-cli": "22.1.3",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@octokit/types": "17.0.0",
    "@playwright/test": "1.62.1",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "angular-eslint": "22.1.0",
    "cross-env": "10.1.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "jsdom": "30.0.1",
    "lint-staged": "17.3.0",
    "ng-packagr": "22.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-sh": "0.19.0",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "26.7.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "error"
    }
  }
}
