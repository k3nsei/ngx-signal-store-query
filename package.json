{
  "name": "@ngx-signal-store-query/source",
  "version": "0.11.0",
  "private": true,
  "scripts": {
    "build:demo": "ng build demo --configuration=production",
    "build:lib": "ng build ngx-signal-store-query --configuration=production",
    "clear-snapshots": "rimraf -g \"{apps,libs}/**/__snapshots__\"",
    "e2e:install-browsers": "pnpm run --dir=apps/demo-e2e install-browsers",
    "e2e:test": "pnpm run --dir=apps/demo-e2e test",
    "e2e:test-with-ui": "pnpm run --dir=apps/demo-e2e test --ui",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "ng lint",
    "ng": "ng",
    "prepare": "(git config core.hookspath .githooks && chmod +x .githooks/*) || true",
    "serve": "ng serve demo",
    "test": "ng test",
    "test:all": "pnpm test:demo --no-watch --quiet --no-watch && pnpm test:lib --no-watch --quiet",
    "test:demo": "ng test demo",
    "test:lib": "ng test ngx-signal-store-query"
  },
  "dependencies": {
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/material": "22.2.5",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-server": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/ssr": "22.2.5",
    "@ngrx/signals": "22.0.1",
    "@tanstack/angular-query-experimental": "5.105.0",
    "@tanstack/query-devtools": "5.105.0",
    "express": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@octokit/types": "18.0.0",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "angular-eslint": "22.6.0",
    "cross-env": "10.1.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "ng-packagr": "22.2.6",
    "prettier": "3.9.10",
    "prettier-plugin-packagejson": "3.0.3",
    "prettier-plugin-sh": "0.20.2",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.13.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "warn"
    }
  }
}
